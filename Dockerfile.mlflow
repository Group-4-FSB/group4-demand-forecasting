# Minimal MLflow tracking server image — kept separate from the API's Dockerfile
# so the serving image never bundles the tracking-server package.
FROM python:3.10-slim

RUN pip install --no-cache-dir mlflow==2.14.1

RUN useradd --create-home --uid 1000 mlflowuser
RUN mkdir -p /mlflow && chown -R mlflowuser:mlflowuser /mlflow
USER mlflowuser
WORKDIR /mlflow

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000/health', timeout=3)" || exit 1

# --serve-artifacts + --artifacts-destination proxies artifact up/download
# through the tracking server's REST API, so client containers only ever
# need MLFLOW_TRACKING_URI=http://mlflow:5000 — no shared filesystem needed.
CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--serve-artifacts", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--host", "0.0.0.0", \
     "--port", "5000"]
