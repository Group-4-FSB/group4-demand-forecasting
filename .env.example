# Copy to .env and adjust as needed. Loaded by src/demand_forecast/config.py

# Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=demand-forecast
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_MODEL_NAME=demand-forecast-lgbm
MLFLOW_MODEL_ALIAS=production

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Modeling
TEST_HOLDOUT_WEEKS=8

# scripts/retrain_if_stale.py: force a retrain attempt once `production` is
# at least this many days old (still subject to the quality gate in train.py)
RETRAIN_MAX_AGE_DAYS=7
# ...and start logging a WARNING (+ firing the Prometheus
# ProductionModelApproachingStaleness alert) this many days before that.
RETRAIN_WARNING_LEAD_DAYS=2
